{
    "target": "esp32s3",
    "builds": [
        {
            "name": "bread-compact-wifi",
            "sdkconfig_append": [
                "CONFIG_OLED_SSD1306_128X32=y",
                "CONFIG_MOTION_PEER_UART=y",
                "CONFIG_MOTION_PEER_UART_BAUD=115200"
            ]
        },
        {
            "name": "bread-compact-wifi-128x64",
            "sdkconfig_append": [
                "CONFIG_OLED_SSD1306_128X64=y",
                "CONFIG_MOTION_PEER_UART=y",
                "CONFIG_MOTION_PEER_UART_BAUD=115200"
            ]
        }
    ]
}