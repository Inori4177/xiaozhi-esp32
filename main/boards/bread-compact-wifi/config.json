{
    "target": "esp32s3",
    "builds": [
        {
            "name": "bread-compact-wifi",
            "sdkconfig_append": [
                "CONFIG_MSP3525_LASER_UI=y",
                "CONFIG_PARTITION_TABLE_CUSTOM_FILENAME=\"partitions/v2/16m_laser_ui.csv\"",
                "CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y",
                "CONFIG_ESPTOOLPY_FLASHMODE_QIO=y",
                "CONFIG_SPIRAM=y",
                "CONFIG_SPIRAM_MODE_OCT=y",
                "CONFIG_SPIRAM_SPEED_80M=y",
                "CONFIG_ESP_INT_WDT_TIMEOUT_MS=3000",
                "CONFIG_COMPILER_OPTIMIZATION_PERF=y",
                "CONFIG_LV_ATTRIBUTE_FAST_MEM_USE_IRAM=y",
                "CONFIG_LV_DEF_REFR_PERIOD=16",
                "CONFIG_LV_USE_LODEPNG=n",
                "CONFIG_LV_USE_DRAW_SW_COMPLEX_GRADIENTS=n",
                "CONFIG_LV_DRAW_SW_SHADOW=n",
                "CONFIG_LV_USE_SNAPSHOT=n"
            ]
        },
        {
            "name": "bread-compact-wifi-laser-ui",
            "sdkconfig_append": [
                "CONFIG_MSP3525_LASER_UI=y",
                "CONFIG_PARTITION_TABLE_CUSTOM_FILENAME=\"partitions/v2/16m_laser_ui.csv\"",
                "CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y",
                "CONFIG_ESPTOOLPY_FLASHMODE_QIO=y",
                "CONFIG_SPIRAM=y",
                "CONFIG_SPIRAM_MODE_OCT=y",
                "CONFIG_SPIRAM_SPEED_80M=y",
                "CONFIG_ESP_INT_WDT_TIMEOUT_MS=3000",
                "CONFIG_COMPILER_OPTIMIZATION_PERF=y",
                "CONFIG_LV_ATTRIBUTE_FAST_MEM_USE_IRAM=y",
                "CONFIG_LV_DEF_REFR_PERIOD=16",
                "CONFIG_LV_USE_LODEPNG=n",
                "CONFIG_LV_USE_DRAW_SW_COMPLEX_GRADIENTS=n",
                "CONFIG_LV_DRAW_SW_SHADOW=n",
                "CONFIG_LV_USE_SNAPSHOT=n"
            ]
        }
    ]
}
