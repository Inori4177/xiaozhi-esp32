{
    "target": "esp32s3",
    "builds": [
        {
            "name": "esp32s3-msp3525-lcd-3.5",
            "sdkconfig_append": [
                "CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y",
                "CONFIG_ESPTOOLPY_FLASHMODE_QIO=y",
                "CONFIG_SPIRAM=y",
                "CONFIG_SPIRAM_MODE_OCT=y",
                "CONFIG_SPIRAM_SPEED_40M=y",
                "CONFIG_ESP_INT_WDT_TIMEOUT_MS=3000"
            ]
        },
        {
            "name": "esp32s3-msp3525-lcd-3.5-laser-ui",
            "sdkconfig_append": [
                "CONFIG_BOARD_TYPE_ESP32S3_MSP3525_LCD_3_5=y",
                "CONFIG_MSP3525_LASER_UI=y",
                "CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y",
                "CONFIG_ESPTOOLPY_FLASHMODE_QIO=y",
                "CONFIG_SPIRAM=y",
                "CONFIG_SPIRAM_MODE_OCT=y",
                "CONFIG_SPIRAM_SPEED_80M=y",
                "CONFIG_ESP_INT_WDT_TIMEOUT_MS=3000",
                "CONFIG_COMPILER_OPTIMIZATION_PERF=y",
                "CONFIG_LV_ATTRIBUTE_FAST_MEM_USE_IRAM=y",
                "CONFIG_LV_DEF_REFR_PERIOD=16",
                "CONFIG_LV_USE_DRAW_SW_COMPLEX_GRADIENTS=y",
                "CONFIG_LV_GRADIENT_MAX_STOPS=6",
                "CONFIG_LV_DRAW_SW_SHADOW=n",
                "CONFIG_LV_USE_SNAPSHOT=n"
            ]
        },
        {
            "name": "esp32s3-msp3525-lcd-3.5-touch-test",
            "sdkconfig_append": [
                "CONFIG_BOARD_TYPE_ESP32S3_MSP3525_LCD_3_5=y",
                "CONFIG_MSP3525_TOUCH_TEST=y",
                "CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y",
                "CONFIG_ESPTOOLPY_FLASHMODE_QIO=y",
                "CONFIG_SPIRAM=y",
                "CONFIG_SPIRAM_MODE_OCT=y",
                "CONFIG_SPIRAM_SPEED_40M=y",
                "CONFIG_ESP_INT_WDT_TIMEOUT_MS=3000"
            ]
        }
    ]
}
